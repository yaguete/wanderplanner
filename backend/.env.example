ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=
# Tope diario global durable de cache misses de pago de /thumb (Places) y /cover
# (Unsplash), vía usage_events.kind=photo_paid. Wikimedia no cuenta.
# MAX_PHOTO_LOOKUPS_DAY=2000

# Límites de uso por usuario (usage_events). Invitado = lifetime; registrado = rolling.
# GUEST_MAX_EXTRACTIONS=1
# GUEST_MAX_ASSISTANT_MESSAGES=10
# GUEST_MAX_PHOTO_LOOKUPS=30
# USER_MAX_EXTRACTIONS_DAY=10
# USER_MAX_EXTRACTIONS_MONTH=50
# USER_MAX_ASSISTANT_MESSAGES_DAY=50
# USER_MAX_PHOTO_LOOKUPS_DAY=300

# GUEST_MAX_DAY_SUMMARIES=5
# GUEST_MAX_COUNTRY_TASKS=5
# USER_MAX_DAY_SUMMARIES_DAY=60
# USER_MAX_COUNTRY_TASKS_DAY=30
# TTL en días de las Recomendaciones de viaje MAE (refresco en la petición)
# TRAVEL_BRIEF_TTL_DAYS=7

# Asistente de viaje (DeepSeek + Tavily)
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
# ASSISTANT_MODEL=deepseek-v4-flash

# Supabase — verificación de JWT y cachés service_role (NUNCA en el frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret (Settings → API). Preferible en prod; si falta, se usa el JWKS de SUPABASE_URL.
# SUPABASE_JWT_SECRET=
# Obliga Bearer token en /itinerary, /thumb, /cover y /assistant/chat (pon true en producción)
# REQUIRE_AUTH=false
# EXTRACTION_REVALIDATE_DAYS=2
# EXTRACTION_HARD_TTL_DAYS=90
# EXTRACTION_CACHE_TTL_DAYS=90
# GUEST_MAX_REFRESHES=3
# USER_MAX_REFRESHES_DAY=20
# Orígenes permitidos por CORS, separados por comas
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Tope diario por IP de POST /funnel (contadores del CTA).
# FUNNEL_MAX_IP_DAY=60

# POST /maps/resolve: short links de Google Maps del artículo → {lng,lat}.
# MAPS_LINK_RESOLVE_ENABLED=true
# GUEST_MAX_MAPS_RESOLVES=40
# USER_MAX_MAPS_RESOLVES_DAY=200

# Instagram (POST /itinerary). Default off sin clave de vendor.
# En local: oembed (caption vía /api/v1/oembed/, sin vendor) o fixture (JSON local).
# Prod: external (o graphql). INSTAGRAM_OCR_ENABLED=true por defecto cuando hay código.
# INSTAGRAM_PROVIDER=off
# INSTAGRAM_PROVIDER=oembed
# INSTAGRAM_PROVIDER=fixture
# INSTAGRAM_PROVIDER_URL=
# INSTAGRAM_PROVIDER_KEY=
# INSTAGRAM_GRAPHQL_DOC_ID=
# INSTAGRAM_RESOLVE_TIMEOUT_S=20
# INSTAGRAM_OCR_ENABLED=true
# INSTAGRAM_OCR_MIN_WIDTH=640
# INSTAGRAM_OCR_MAX_SLIDES=8
# INSTAGRAM_OCR_MAX_BYTES=5000000
# INSTAGRAM_OCR_FETCH_BUDGET_S=12
# INSTAGRAM_OCR_MAX_OUTPUT_TOKENS=2000
# INSTAGRAM_OCR_MAX_CAPTION_CHARS=   # 0 / vacío = sin tope (dial de §3.3)
# USER_MAX_INSTAGRAM_EXTRACTIONS_DAY=5
