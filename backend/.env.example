ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=
# Tope diario global de cache misses de /thumb y /cover (cinturón; no sustituye T1.2)
# MAX_PHOTO_LOOKUPS_DAY=2000

# Límites de uso por usuario (usage_events). Invitado = lifetime; registrado = rolling.
# GUEST_MAX_EXTRACTIONS=1
# GUEST_MAX_ASSISTANT_MESSAGES=10
# GUEST_MAX_PHOTO_LOOKUPS=30
# USER_MAX_EXTRACTIONS_DAY=10
# USER_MAX_EXTRACTIONS_MONTH=50
# USER_MAX_ASSISTANT_MESSAGES_DAY=50
# USER_MAX_PHOTO_LOOKUPS_DAY=300

# Asistente de viaje (DeepSeek + Tavily)
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
# ASSISTANT_MODEL=deepseek-v4-flash

# Supabase — verificación de JWT y cachés service_role (NUNCA en el frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret (Settings → API). Preferible en prod; si falta, se usa el JWKS de SUPABASE_URL.
# SUPABASE_JWT_SECRET=
# Obliga Bearer token en /itinerary, /thumb, /cover y /assistant/chat (pon true en producción)
# REQUIRE_AUTH=false
# EXTRACTION_CACHE_TTL_DAYS=30
# Orígenes permitidos por CORS, separados por comas
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
